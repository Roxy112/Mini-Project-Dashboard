# 环境变量与敏感配置 (重要: 避免密码泄露)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Node 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 临时缓存与构建信息
.vite/
*.tsbuildinfo
.eslintcache

# 编辑器与 IDE 配置
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统临时文件
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Prisma 生成目录 (如使用自定义 output 时)
/src/generated/prisma
